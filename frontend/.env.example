# ============================================================================
# Environment variables — Pitch Proof
# Copy to .env.local and fill in. NEVER commit real keys.
# ============================================================================

# TOMI: the OpenAI key must live on the BACKEND only, never in the frontend
# bundle (anything Vite exposes with the VITE_ prefix ships to the browser).
# Put this in your server/API environment, not in a VITE_ variable.
OPENAI_API_KEY=

# Base URL of the backend that runs the analysis (used by the frontend fetch).
# Leave empty to call same-origin /api/analyze.
VITE_API_BASE_URL=
